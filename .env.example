# Local config; copy to .env and keep real secrets out of version control.
MODE=paper
PAPER_DB=data/paper.sqlite3
INITIAL_CASH_USD=1000
POLL_INTERVAL_SECONDS=60
RL_SEED=paper-v1
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Paper capital-risk thresholds (strategy version episodic-q-1+capital-3).
# Percentages are plain numbers: 2 means 2%. Keep them constant between live paper and replay.
MAX_POSITION_PCT=2
MAX_EXPOSURE_PCT=10
MIN_CASH_RESERVE_PCT=50
MAX_TRADE_LOSS_PCT=0.25
MAX_OPEN_POSITIONS=4
MAX_POSITION_QUOTE_AGE_S=120
REENTRY_COOLDOWN_MINUTES=45

# Reserved for future, separate provider integrations. NOT USED by the current collector.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
SOLANA_RPC_URL=

# PumpPortal creation events and DexScreener pairs are public; no key needed.
